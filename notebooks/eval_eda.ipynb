 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Genie Evaluation EDA (Exploratory Data Analysis)\n",
    "\n",
    "This notebook provides comprehensive exploratory data analysis of evaluation results, including:\n",
    "- Failure mode distributions\n",
    "- Severity and confidence trends\n",
    "- Judge agreement heatmaps\n",
    "- Confidence interval analysis\n",
    "- Cross-tabulation and correlation analysis\n",
    "\n",
    "**Prerequisites:**\n",
    "- Evaluation results exported as JSON: `eval_results.json`\n",
    "- Use `cd /Users/genesis/Developer/goworkspace/src/github.com/c2siorg/genie && go run ./cmd/eval-multiturn -export eval_results.json` to generate it"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "from collections import Counter, defaultdict\n",
    "import json\n",
    "from pathlib import Path\n",
    "\n",
    "# Configure visualization\n",
    "sns.set_style('whitegrid')\n",
    "plt.rcParams['figure.figsize'] = (14, 6)\n",
    "plt.rcParams['font.size'] = 10\n",
    "\n",
    "# Data file path\n",
    "DATA_PATH = 'eval_results.json'\n",
    "\n",
    "print(f'Loading evaluation results from {DATA_PATH}...')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Data Loading & Preprocessing"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Load JSON data\n",
    "with open(DATA_PATH, 'r') as f:\n",
    "    raw_data = json.load(f)\n",
    "\n",
    "# Convert to DataFrame\n",
    "df = pd.DataFrame(raw_data)\n",
    "\n",
    "print(f'Loaded {len(df)} evaluation results')\n",
    "print(f'\\nColumns: {list(df.columns)}')\n",
    "print(f'\\nShape: {df.shape}')\n",
    "print(f'\\nData types:\\n{df.dtypes}')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Display first few rows\n",
    "df.head()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Basic statistics\n",
    "print('\\n=== BASIC STATISTICS ===')\n",
    "print(f'Total traces: {len(df)}')\n",
    "print(f'Unique failure modes: {df[\"failure_mode\"].nunique()}')\n",
    "print(f'Unique domains: {df[\"domain\"].nunique()}')\n",
    "print(f'Unique agents: {df[\"agent\"].nunique()}')\n",
    "print(f'Unique segments: {df[\"customer_segment\"].nunique()}')\n",
    "print(f'\\nNull values:')\n",
    "print(df.isnull().sum())"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Failure Mode Distribution"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Failure mode counts\n",
    "failure_counts = df['failure_mode'].value_counts()\n",
    "print(f'\\nTop 15 Failure Modes:')\n",
    "print(failure_counts.head(15))\n",
    "\n",
    "# Visualization\n",
    "fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(16, 6))\n",
    "\n",
    "# Bar chart\n",
    "failure_counts.head(15).plot(kind='barh', ax=ax1, color='steelblue')\n",
    "ax1.set_title('Top 15 Failure Modes by Frequency', fontsize=12, fontweight='bold')\n",
    "ax1.set_xlabel('Count')\n",
    "ax1.invert_yaxis()\n",
    "\n",
    "# Pie chart (top 10 + other)\n",
    "top_n = 10\n",
    "top_failures = failure_counts.head(top_n)\n",
    "other_count = failure_counts[top_n:].sum()\n",
    "pie_data = pd.concat([top_failures, pd.Series({'Other': other_count})])\n",
    "ax2.pie(pie_data, labels=pie_data.index, autopct='%1.1f%%', startangle=90)\n",
    "ax2.set_title(f'Failure Mode Distribution (Top {top_n} + Other)', fontsize=12, fontweight='bold')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Domain & Category Analysis"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Domain analysis\n",
    "domain_counts = df['domain'].value_counts()\n",
    "print('\\n=== DOMAIN DISTRIBUTION ===')\n",
    "print(domain_counts)\n",
    "\n",
    "# Category analysis\n",
    "category_counts = df['category'].value_counts()\n",
    "print('\\n=== CATEGORY DISTRIBUTION ===')\n",
    "print(category_counts)\n",
    "\n",
    "# Visualization\n",
    "fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(14, 5))\n",
    "\n",
    "domain_counts.plot(kind='bar', ax=ax1, color='coral')\n",
    "ax1.set_title('Failures by Domain', fontsize=12, fontweight='bold')\n",
    "ax1.set_xlabel('Domain')\n",
    "ax1.set_ylabel('Count')\n",
    "ax1.tick_params(axis='x', rotation=45)\n",
    "\n",
    "category_counts.plot(kind='bar', ax=ax2, color='lightgreen')\n",
    "ax2.set_title('Failures by Category', fontsize=12, fontweight='bold')\n",
    "ax2.set_xlabel('Category')\n",
    "ax2.set_ylabel('Count')\n",
    "ax2.tick_params(axis='x', rotation=45)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Severity & Confidence Analysis"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Severity distribution\n",
    "severity_counts = df['severity'].value_counts()\n",
    "severity_order = ['critical', 'high', 'medium', 'low']\n",
    "severity_counts = severity_counts.reindex([s for s in severity_order if s in severity_counts.index])\n",
    "\n",
    "print('\\n=== SEVERITY DISTRIBUTION ===')\n",
    "print(severity_counts)\n",
    "print(f'\\nPercentage:')\n",
    "print((severity_counts / severity_counts.sum() * 100).round(2))\n",
    "\n",
    "# Confidence statistics\n",
    "print('\\n=== CONFIDENCE STATISTICS ===')\n",
    "print(f'Mean: {df[\"confidence\"].mean():.2f}')\n",
    "print(f'Median: {df[\"confidence\"].median():.2f}')\n",
    "print(f'Std Dev: {df[\"confidence\"].std():.2f}')\n",
    "print(f'Min: {df[\"confidence\"].min()}')\n",
    "print(f'Max: {df[\"confidence\"].max()}')\n",
    "\n",
    "# Root cause gulf statistics\n",
    "print('\\n=== ROOT CAUSE GULF STATISTICS ===')\n",
    "print(f'Mean: {df[\"root_cause_gulf\"].mean():.2f}%')\n",
    "print(f'Median: {df[\"root_cause_gulf\"].median():.2f}%')\n",
    "print(f'Std Dev: {df[\"root_cause_gulf\"].std():.2f}%')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Severity and Confidence visualization\n",
    "fig, axes = plt.subplots(2, 2, figsize=(14, 10))\n",
    "\n",
    "# Severity bar chart\n",
    "severity_counts.plot(kind='bar', ax=axes[0, 0], color='indianred')\n",
    "axes[0, 0].set_title('Severity Distribution', fontsize=12, fontweight='bold')\n",
    "axes[0, 0].set_xlabel('Severity')\n",
    "axes[0, 0].set_ylabel('Count')\n",
    "axes[0, 0].tick_params(axis='x', rotation=0)\n",
    "\n",
    "# Confidence distribution\n",
    "axes[0, 1].hist(df['confidence'], bins=20, color='steelblue', edgecolor='black')\n",
    "axes[0, 1].set_title('Confidence Score Distribution', fontsize=12, fontweight='bold')\n",
    "axes[0, 1].set_xlabel('Confidence (%)')\n",
    "axes[0, 1].set_ylabel('Frequency')\n",
    "axes[0, 1].axvline(df['confidence'].mean(), color='red', linestyle='--', label=f'Mean: {df[\"confidence\"].mean():.1f}')\n",
    "axes[0, 1].legend()\n",
    "\n",
    "# Root cause gulf distribution\n",
    "axes[1, 0].hist(df['root_cause_gulf'], bins=20, color='seagreen', edgecolor='black')\n",
    "axes[1, 0].set_title('Root Cause Gulf Distribution', fontsize=12, fontweight='bold')\n",
    "axes[1, 0].set_xlabel('Root Cause Gulf (%)')\n",
    "axes[1, 0].set_ylabel('Frequency')\n",
    "axes[1, 0].axvline(df['root_cause_gulf'].mean(), color='red', linestyle='--', label=f'Mean: {df[\"root_cause_gulf\"].mean():.1f}%')\n",
    "axes[1, 0].legend()\n",
    "\n",
    "# Severity vs Confidence scatter\n",
    "severity_to_num = {'critical': 4, 'high': 3, 'medium': 2, 'low': 1}\n",
    "df['severity_num'] = df['severity'].map(severity_to_num)\n",
    "axes[1, 1].scatter(df['confidence'], df['severity_num'], alpha=0.5, s=30, color='purple')\n",
    "axes[1, 1].set_title('Confidence vs Severity', fontsize=12, fontweight='bold')\n",
    "axes[1, 1].set_xlabel('Confidence (%)')\n",
    "axes[1, 1].set_ylabel('Severity Level')\n",
    "axes[1, 1].set_yticks([1, 2, 3, 4])\n",
    "axes[1, 1].set_yticklabels(['low', 'medium', 'high', 'critical'])\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5. Agent & Segment Analysis"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Agent distribution\n",
    "agent_counts = df['agent'].value_counts()\n",
    "print('\\n=== AGENT DISTRIBUTION ===')\n",
    "print(agent_counts)\n",
    "\n",
    "# Customer segment distribution\n",
    "segment_counts = df['customer_segment'].value_counts()\n",
    "print('\\n=== CUSTOMER SEGMENT DISTRIBUTION ===')\n",
