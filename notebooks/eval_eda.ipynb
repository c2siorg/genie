    "segment_counts.plot(kind='bar', ax=ax2, color='gold')\n",
    "ax2.set_title('Failures by Customer Segment', fontsize=12, fontweight='bold')\n",
    "ax2.set_xlabel('Segment')\n",
    "ax2.set_ylabel('Count')\n",
    "ax2.tick_params(axis='x', rotation=45)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 6. Cross-Tabulation Analysis"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Domain vs Severity cross-tabulation\n",
    "domain_severity = pd.crosstab(df['domain'], df['severity'])\n",
    "# Reorder severity columns\n",
    "severity_order = ['critical', 'high', 'medium', 'low']\n",
    "domain_severity = domain_severity[[col for col in severity_order if col in domain_severity.columns]]\n",
    "\n",
    "print('\\n=== DOMAIN vs SEVERITY CROSS-TABULATION ===')\n",
    "print(domain_severity)\n",
    "\n",
    "# Heatmap\n",
    "fig, ax = plt.subplots(figsize=(10, 6))\n",
    "sns.heatmap(domain_severity, annot=True, fmt='d', cmap='RdYlGn_r', ax=ax, cbar_kws={'label': 'Count'})\n",
    "ax.set_title('Domain vs Severity Heatmap', fontsize=12, fontweight='bold')\n",
    "ax.set_ylabel('Domain')\n",
    "ax.set_xlabel('Severity')\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Category vs Agent cross-tabulation\n",
    "category_agent = pd.crosstab(df['category'], df['agent'])\n",
    "\n",
    "print('\\n=== CATEGORY vs AGENT CROSS-TABULATION ===')\n",
    "print(category_agent)\n",
    "\n",
    "# Heatmap\n",
    "fig, ax = plt.subplots(figsize=(12, 6))\n",
    "sns.heatmap(category_agent, annot=True, fmt='d', cmap='YlOrRd', ax=ax, cbar_kws={'label': 'Count'})\n",
    "ax.set_title('Category vs Agent Heatmap', fontsize=12, fontweight='bold')\n",
    "ax.set_ylabel('Category')\n",
    "ax.set_xlabel('Agent')\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 7. Confidence Intervals & Trends"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Confidence by severity\n",
    "confidence_by_severity = df.groupby('severity')['confidence'].agg(['mean', 'std', 'count'])\n",
    "confidence_by_severity = confidence_by_severity.reindex(['critical', 'high', 'medium', 'low'])\n",
    "\n",
    "# 95% confidence intervals\n",
    "from scipy import stats\n",
    "confidence_by_severity['ci_lower'] = confidence_by_severity.apply(\n",
    "    lambda row: row['mean'] - 1.96 * row['std'] / np.sqrt(row['count']), axis=1\n",
    ")\n",
    "confidence_by_severity['ci_upper'] = confidence_by_severity.apply(\n",
    "    lambda row: row['mean'] + 1.96 * row['std'] / np.sqrt(row['count']), axis=1\n",
    ")\n",
    "\n",
    "print('\\n=== CONFIDENCE BY SEVERITY (with 95% CI) ===')\n",
    "print(confidence_by_severity[['mean', 'std', 'ci_lower', 'ci_upper', 'count']])"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Visualize confidence intervals\n",
    "fig, ax = plt.subplots(figsize=(10, 6))\n",
    "\n",
    "x_pos = np.arange(len(confidence_by_severity))\n",
    "y = confidence_by_severity['mean']\n",
    "error = confidence_by_severity['ci_upper'] - confidence_by_severity['mean']\n",
    "\n",
    "ax.bar(x_pos, y, yerr=error, capsize=5, color='skyblue', edgecolor='navy', alpha=0.7)\n",
    "ax.set_xticks(x_pos)\n",
    "ax.set_xticklabels(confidence_by_severity.index)\n",
    "ax.set_title('Mean Confidence Score by Severity (with 95% CI)', fontsize=12, fontweight='bold')\n",
    "ax.set_ylabel('Mean Confidence (%)')\n",
    "ax.set_xlabel('Severity Level')\n",
    "ax.grid(axis='y', alpha=0.3)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Root cause gulf by domain\n",
    "gulf_by_domain = df.groupby('domain')['root_cause_gulf'].agg(['mean', 'std', 'count'])\n",
    "\n",
    "# 95% confidence intervals\n",
    "gulf_by_domain['ci_lower'] = gulf_by_domain.apply(\n",
    "    lambda row: row['mean'] - 1.96 * row['std'] / np.sqrt(row['count']), axis=1\n",
    ")\n",
    "gulf_by_domain['ci_upper'] = gulf_by_domain.apply(\n",
    "    lambda row: row['mean'] + 1.96 * row['std'] / np.sqrt(row['count']), axis=1\n",
    ")\n",
    "\n",
    "print('\\n=== ROOT CAUSE GULF BY DOMAIN (with 95% CI) ===')\n",
    "print(gulf_by_domain[['mean', 'std', 'ci_lower', 'ci_upper', 'count']])"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Visualize gulf confidence intervals\n",
    "fig, ax = plt.subplots(figsize=(12, 6))\n",
    "\n",
    "x_pos = np.arange(len(gulf_by_domain))\n",
    "y = gulf_by_domain['mean']\n",
    "error = gulf_by_domain['ci_upper'] - gulf_by_domain['mean']\n",
    "\n",
    "ax.barh(x_pos, y, xerr=error, capsize=5, color='lightcoral', edgecolor='darkred', alpha=0.7)\n",
    "ax.set_yticks(x_pos)\n",
    "ax.set_yticklabels(gulf_by_domain.index)\n",
    "ax.set_title('Mean Root Cause Gulf by Domain (with 95% CI)', fontsize=12, fontweight='bold')\n",
    "ax.set_xlabel('Root Cause Gulf (%)')\n",
    "ax.grid(axis='x', alpha=0.3)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 8. Correlation Analysis"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Prepare numeric data for correlation\n",
    "numeric_cols = ['confidence', 'root_cause_gulf']\n",
    "\n",
    "# Add numeric severity\n",
    "df['severity_numeric'] = df['severity'].map({'critical': 4, 'high': 3, 'medium': 2, 'low': 1})\n",
    "\n",
    "correlation_data = df[['confidence', 'root_cause_gulf', 'severity_numeric']].corr()\n",
    "\n",
    "print('\\n=== CORRELATION MATRIX ===')\n",
    "print(correlation_data)\n",
    "\n",
    "# Heatmap\n",
    "fig, ax = plt.subplots(figsize=(8, 6))\n",
    "sns.heatmap(correlation_data, annot=True, fmt='.3f', cmap='coolwarm', center=0, \n",
    "            square=True, ax=ax, cbar_kws={'label': 'Correlation'})\n",
    "ax.set_title('Correlation Matrix: Confidence, Root Cause Gulf, Severity', fontsize=12, fontweight='bold')\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 9. Judge Agreement Analysis"
   ]
  },
  {
   "cell_type": {"execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Analyze judge consistency across failure modes\n",
    "# (Assuming multiple evaluators/judges provided scores)\n",
    "\n",
    "# Group by failure mode and compute confidence variance\n",
    "judge_agreement = df.groupby('failure_mode').agg({\n",
    "    'confidence': ['mean', 'std', 'count'],\n",
    "    'severity': lambda x: x.nunique(),  # unique severity assignments\n",
    "    'root_cause_gulf': 'std'\n",
    "}).round(3)\n",
    "\n",
    "judge_agreement.columns = ['avg_confidence', 'conf_std', 'count', 'severity_variance', 'gulf_std']\n",
    "judge_agreement = judge_agreement.sort_values('conf_std', ascending=False)\n",
    "\n",
    "print('\\n=== JUDGE AGREEMENT BY FAILURE MODE ===')\n",
    "print('(Higher std = less agreement)')\n",
    "print(judge_agreement.head(10))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Visualize judge agreement (confidence std by failure mode)\n",
    "top_disagreement = judge_agreement.nlargest(10, 'conf_std')\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(12, 6))\n",
    "top_disagreement['conf_std'].plot(kind='barh', ax=ax, color='salmon')\n",
    "ax.set_title('Top 10 Failure Modes with Highest Judge Disagreement', fontsize=12, fontweight='bold')\n",
    "ax.set_xlabel('Confidence Score Std Dev (higher = more disagreement)')\n",
    "ax.invert_yaxis()\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 10. Summary Statistics & Insights"
   ]
  },
  {
   "cell_type": {"execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "print('\\n' + '='*60)\n",
    "print('EVALUATION SUMMARY REPORT')\n",
    "print('='*60)\n",
    "\n",
    "print(f'\\nTotal Evaluation Results: {len(df)}')\n",
    "print(f'\\nDomain Breakdown:')\n",
    "for domain, count in domain_counts.items():\n",
    "    pct = count / len(df) * 100\n",
    "    print(f'  {domain:20s}: {count:4d} ({pct:5.1f}%)')\n",
    "\n",
    "print(f'\\nSeverity Breakdown:')\n",
    "for sev in ['critical', 'high', 'medium', 'low']:\n",
    "    if sev in severity_counts.index:\n",
    "        count = severity_counts[sev]\n",
    "        pct = count / len(df) * 100\n",
    "        print(f'  {sev:10s}: {count:4d} ({pct:5.1f}%)')\n",
    "\n",
    "print(f'\\nKey Metrics:')\n",
    "print(f'  Average Confidence: {df[\"confidence\"].mean():.1f}%')\n",
    "print(f'  Average Root Cause Gulf: {df[\"root_cause_gulf\"].mean():.1f}%')\n",
    "print(f'  Median Confidence: {df[\"confidence\"].median():.1f}%')\n",
    "print(f'  Median Root Cause Gulf: {df[\"root_cause_gulf\"].median():.1f}%')\n",
    "\n",
    "print(f'\\nTop 5 Failure Modes:')\n",
    "for i, (fm, count) in enumerate(failure_counts.head(5).items(), 1):\n",
    "    pct = count / len(df) * 100\n",
    "    print(f'  {i}. {fm}: {count} ({pct:.1f}%)')\n",
    "\n",
