# Copy this file to .env and fill in your real values.
# NEVER commit .env to git — it is listed in .gitignore.

# ── Genie API ──────────────────────────────────────────────────────────────
GENIE_JWT_SECRET=your-hex-or-random-string-here
GENIE_KEK_BASE64=your-base64-32-byte-key-here
GENIE_DB_DSN=postgres://genie:genie@localhost:5432/genie?sslmode=disable
GENIE_HTTP_ADDR=:8080

# ── Ollama (local LLM) ────────────────────────────────────────────────────
# "ollama" (default) | "mock" (no local model needed)
GENIE_LLM=ollama
GENIE_OLLAMA_URL=http://localhost:11434
# Needs a tool-calling capable model: qwen3.5, granite4.1, llama3.1:8b+
GENIE_OLLAMA_CHAT=qwen3.5:latest
GENIE_OLLAMA_EMBED=nomic-embed-text

# ── OTel / Observability ───────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
GENIE_OTEL_INSECURE=true

# ── Laminar (eval tracing) ─────────────────────────────────────────────────
# Get your project API key from http://localhost:5667 → Settings → API Keys
LMNR_PROJECT_API_KEY=your-laminar-key-here
# Override if Laminar is not on the default port
LMNR_BASE_URL=http://localhost:8000

# ── Web Search (optional — first key found wins) ──────────────────────────
# Without a key the agent falls back to DuckDuckGo Instant Answers (summaries only).
# TAVILY_API_KEY=your-tavily-key-here       # https://tavily.com  (best for agents)
# EXA_API_KEY=your-exa-key-here             # https://exa.ai      (semantic search)
# BRAVE_API_KEY=your-brave-key-here         # https://brave.com/search/api

# ── AI policy ─────────────────────────────────────────────────────────────
GENIE_AI_POLICY=config/ai-policy.example.yaml
