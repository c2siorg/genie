{
  "name": "genie-e2e-tests",
  "version": "1.0.0",
  "description": "Comprehensive End-to-End tests for Genie financial platform",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:headed": "playwright test --headed",
    "test:settlement": "playwright test settlement.spec.ts",
    "test:security": "playwright test security.spec.ts",
    "test:evaluation": "playwright test evaluation.spec.ts",
    "test:compliance": "playwright test compliance.spec.ts",
    "test:chrome": "playwright test --project chromium",
    "test:firefox": "playwright test --project firefox",
    "test:webkit": "playwright test --project webkit",
    "test:mobile": "playwright test --project mobile-chrome",
    "test:ci": "playwright test --reporter=json,junit,html",
    "test:parallel": "playwright test --workers=4",
    "test:serial": "playwright test --workers=1",
    "test:a11y": "playwright test a11y/",
    "test:a11y:wcag": "playwright test a11y/wcag.spec.ts",
    "test:a11y:keyboard": "playwright test a11y/keyboard.spec.ts",
    "test:a11y:screenreader": "playwright test a11y/screenreader.spec.ts",
    "test:visual": "playwright test visual/",
    "test:visual:pages": "playwright test visual/pages.spec.ts",
    "test:visual:responsive": "playwright test visual/responsive.spec.ts",
    "test:a11y:wcag:update": "playwright test a11y/wcag.spec.ts --update-snapshots",
    "test:visual:update": "playwright test visual/ --update-snapshots",
    "test:unit": "vitest run tests/unit",
    "test:components": "vitest run tests/components",
    "test:unit:watch": "vitest tests/unit",
    "test:components:watch": "vitest tests/components",
    "test:all": "vitest run",
    "test:coverage": "vitest run --coverage",
    "show:report": "playwright show-report",
    "codegen": "playwright codegen http://localhost:8080",
    "trace": "playwright show-trace",
    "install-browsers": "playwright install"
  },
  "keywords": [
    "e2e",
    "testing",
    "playwright",
    "genie",
    "financial",
    "settlement",
    "compliance",
    "evaluation"
  ],
  "author": "Genie Team",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@testing-library/dom": "^9.3.0",
    "@types/node": "^20.10.0",
    "@vitest/coverage-v8": "^1.0.0",
    "axe-core": "^4.8.2",
    "axe-playwright": "^1.2.3",
    "jsdom": "^23.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "dependencies": {
    "jsonwebtoken": "^9.1.0"
  }
}
