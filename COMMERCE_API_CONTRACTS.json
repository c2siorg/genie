      ],
      "response": {
        "struct": "auditLogResponse",
        "status_codes": {
          "200": "Audit log retrieved",
          "400": "Invalid request_id",
          "401": "Unauthenticated",
          "500": "Failed to fetch audit log"
        },
        "fields": [
          {
            "name": "settlement_id",
            "type": "string",
            "description": "Settlement request ID"
          },
          {
            "name": "entries",
